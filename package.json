{
  "name": "highr",
  "private": true,
  "description": "Highr marketing site. Node is only needed to rebuild css/tailwind.css.",
  "scripts": {
    "build:css": "tailwindcss -i css/tailwind.src.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -i css/tailwind.src.css -o css/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
